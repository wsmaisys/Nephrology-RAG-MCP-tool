# Nephrology RAG MCP Configuration
# Copy this file to .env and fill in your values

# Mistral AI API Key (required)
# Get your API key from: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=your_mistral_api_key_here

# MCP Server URL (optional)
# Default: https://nephrology-mcp-server-923690924368.us-central1.run.app/mcp
# For local testing, use: http://localhost:8000/mcp
MCP_URL=https://nephrology-mcp-server-923690924368.us-central1.run.app/mcp
